{
	"name": "ryan-gallery",
	"compatibility_date": "2026-04-07",
	"assets": {
		"directory": "./dist"
	},
	// Runs before every deploy of dist/: refuses a build made with a
	// preview-only sample (`npm run build:sample`: STORY_CHAPTERS_SAMPLE=1,
	// NOTES_SAMPLE=1), so "Sample chapter one" can never reach production.
	// It builds nothing; `npm run build` still comes first.
	"build": {
		"command": "node scripts/assert-no-sample.mjs"
	},
	// Named env for the CI "Deploy Preview" job (`wrangler deploy --env preview`).
	// Named envs do NOT inherit top-level `assets`, so it's re-declared here.
	// Publishes a separate `ryan-gallery-preview` worker — never touches prod.
	"env": {
		"preview": {
			"name": "ryan-gallery-preview",
			// A Custom Domain on the preview worker. `*.workers.dev` is blocked in
			// mainland China and the owner cannot open the preview there at all; a
			// Cloudflare-proxied subdomain of the real zone is reachable. Wrangler
			// creates the DNS record and certificate on deploy. Keep this here:
			// deploying `--env preview` from a branch that omits it hands out a
			// workers.dev URL the owner cannot reach, which has happened twice.
			"routes": [{ "pattern": "preview.ryanxugallery.com", "custom_domain": true }],
			"assets": {
				"directory": "./dist"
			},
			// The preview worker may show a sample build: reported, not refused.
			"build": {
				"command": "node scripts/assert-no-sample.mjs --preview"
			}
		}
	}
}
