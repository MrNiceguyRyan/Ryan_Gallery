---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import AboutPage, { ABOUT_SESSION_KEY, type AboutPortrait } from '../components/about/AboutPage';
import { sanityClient } from 'sanity:client';
import type { Collection, SiteSettings } from '../types';
import { fetchSanityWithRetry } from '../lib/sanityFetch';
import { chapterOrder } from '../lib/chapterOrder';
import { exposureTotals } from '../lib/exposureRecord';
import { PORTRAIT_FALLBACK, PORTRAIT_SIZES, PORTRAIT_WIDTHS, portraitCropUrl, portraitPath } from '../lib/aboutPortrait';
import { silverTables } from '../lib/silverPrint';

const currentPath = Astro.url.pathname;

/**
 * The single siteSettings document (it may not exist yet), and the chapters
 * in the homepage's own shape plus each frame's camera, from which the
 * ticket's counts and the colophon's cameras are reduced. Only photos that
 * reference a chapter are counted, so the total is the 58 the rest of the
 * site counts.
 */
const [rawSettings, rawCollections] = await Promise.all([
  fetchSanityWithRetry(() => sanityClient.fetch<SiteSettings | null>(`
    *[_type == "siteSettings"][0] {
      name,
      bio,
      "avatarUrl": avatar.asset->url,
      email,
      instagram
    }
  `)),
  fetchSanityWithRetry(() => sanityClient.fetch<Collection[]>(`
    *[_type == "collection"] | order(year desc) {
      _id,
      name,
      region,
      year,
      routeOrder,
      "photoCount": count(*[_type == "photo" && references(^._id)]),
      "photos": *[_type == "photo" && references(^._id)] { camera }
    }
  `)),
]);

const settings: SiteSettings = rawSettings ?? {};
const name = settings.name ?? 'Ryan Xu';

// The homepage's chapters (src/lib/chapterOrder), so the ticket's count is
// its count, and what their frames add up to.
const totals = exposureTotals(chapterOrder(rawCollections ?? []));

// The portrait, printed in silver at build time (about/portrait-[w].webp)
// when it is a Sanity asset; otherwise the file itself under the live filter.
const avatarUrl = settings.avatarUrl ?? PORTRAIT_FALLBACK;
const portrait: AboutPortrait = portraitCropUrl(avatarUrl, 840)
  ? {
      src: portraitPath(840),
      srcSet: PORTRAIT_WIDTHS.map((w) => `${portraitPath(w)} ${w}w`).join(', '),
      sizes: PORTRAIT_SIZES,
      width: 840,
      height: 1050,
    }
  : { src: avatarUrl, width: 840, height: 1050, silver: silverTables() };

// Stamped when the page is built — the colophon's "Updated" line and the ©
// year. Formatted here, in one named timezone, so the server and the client
// print the same string: New York, where the archive is based.
const builtAt = new Date();
const updatedOn = builtAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/New_York' });
const year = builtAt.toLocaleDateString('en-US', { year: 'numeric', timeZone: 'America/New_York' });
---

<Layout
  title="About | Ryan"
  description="Photographic archive. Operator: Ryan Xu. Base: New York."
  ogImage={settings.avatarUrl ? `${settings.avatarUrl}?auto=format&w=1200&h=630&fit=crop&q=85` : undefined}
  dark={true}
>
  {/* How the page arrives, decided before its first paint and written on
      <html> (global.css, "/about: darkroom biography"): the contributor cover
      in full on the first visit this session; a repeat visit's develop
      entrance; nothing on a view-transition arrival (the push carries the
      finished page) or under reduced motion. Re-run on every ClientRouter
      arrival. With no JS there is no attribute, and the cover plays over the
      finished page. */}
  <script is:inline data-astro-rerun define:vars={{ sessionKey: ABOUT_SESSION_KEY }}>
    var root = document.documentElement;
    var mode = 'full';
    if (
      root.hasAttribute('data-axis') ||
      root.hasAttribute('data-entry-skip') ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      mode = 'skip';
    } else {
      try {
        if (sessionStorage.getItem(sessionKey) === 'true') mode = 'brief';
        else sessionStorage.setItem(sessionKey, 'true');
      } catch (e) {
        // Private browsing can deny storage; the full cover is the safe default.
      }
    }
    root.setAttribute('data-about-entry', mode);
  </script>
  <Nav client:load currentPath={currentPath} scrim />
  <AboutPage
    client:load
    name={name}
    bio={settings.bio ?? null}
    email={settings.email ?? 'ryan2420159421@gmail.com'}
    instagram={settings.instagram ?? 'https://www.instagram.com/ryan_photoo/'}
    portrait={portrait}
    totals={totals}
    updatedOn={updatedOn}
    year={year}
  />
  {/* The blocks that start below the first screen are armed (read once,
      here, never per frame) and played once when the reader reaches them;
      a block on the first screen is simply set. The state is on <html>, so
      a late or missing script can only leave a block set, never hidden. */}
  <script is:inline data-astro-rerun>
    var root = document.documentElement;
    var page = document.querySelector('.about');
    if (
      page &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      'IntersectionObserver' in window
    ) {
      var vh = window.innerHeight;
      var armed = Array.prototype.filter.call(page.querySelectorAll('[data-about-reveal]'), function (el) {
        return el.getBoundingClientRect().top >= vh * 0.97;
      });
      if (armed.length) {
        root.setAttribute('data-about-armed', armed.map(function (el) { return el.getAttribute('data-about-reveal'); }).join(' '));
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            var reached = (root.getAttribute('data-about-in') || '').split(' ').filter(Boolean);
            reached.push(entry.target.getAttribute('data-about-reveal'));
            root.setAttribute('data-about-in', reached.join(' '));
          });
        }, { rootMargin: '0px 0px -14% 0px', threshold: 0.12 });
        armed.forEach(function (el) { observer.observe(el); });
        document.addEventListener('astro:before-swap', function () { observer.disconnect(); }, { once: true });
      }
    }
  </script>
  {/* The signature follows the scroll, both ways, as it did before the
      rebuild (SignatureScrub: framer's useScroll over ['start 94%',
      'end 52%'] into a spring). The pen is 0 while the autograph's top is
      below 94% of the window and 1 once its foot has risen to 52%, linear
      in the scroll between, and a spring (stiffness 110, damping 28, mass
      0.35) follows it, so a flick of the wheel is written, not jumped. Its
      range is derived from the layout (the offsetTop chain, which no scroll
      and no transform enters) on arrival and on resize, never read per
      frame; the end is held to the page's last scroll position, so the
      autograph always completes. Written as --about-pen on the signature;
      global.css turns it into the mask's dash. Under reduced motion nothing
      is armed and the autograph is whole. */}
  <script is:inline data-astro-rerun>
    (function () {
      var sign = document.querySelector('.about-signature');
      var pen = sign && sign.querySelector('.about-pen');
      var page = document.querySelector('.about-page');
      if (!pen || !page || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var STIFFNESS = 110;
      var DAMPING = 28;
      var MASS = 0.35;
      var start = 0;
      var span = 0;
      var target = 1;
      var value = 1;
      var velocity = 0;
      var frame = 0;
      var last = 0;
      var measure = function () {
        var top = 0;
        for (var el = sign; el; el = el.offsetParent) top += el.offsetTop;
        var vh = window.innerHeight;
        var end = Math.min(top + sign.offsetHeight - 0.52 * vh, document.documentElement.scrollHeight - vh);
        start = top - 0.94 * vh;
        span = end - start;
      };
      var progress = function () {
        // A page too short to scroll through the range shows it whole.
        if (span < 1) return 1;
        var p = (window.scrollY - start) / span;
        return p < 0 ? 0 : p > 1 ? 1 : p;
      };
      var write = function () {
        sign.style.setProperty('--about-pen', (value < 0 ? 0 : value > 1 ? 1 : value).toFixed(4));
      };
      var step = function (now) {
        var dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60;
        last = now;
        // Semi-implicit Euler in 4 ms slices: stable at these constants.
        var n = Math.ceil(dt / 0.004);
        var h = dt / n;
        for (var i = 0; i < n; i += 1) {
          velocity += ((-STIFFNESS * (value - target) - DAMPING * velocity) / MASS) * h;
          value += velocity * h;
        }
        if (Math.abs(value - target) < 0.0005 && Math.abs(velocity) < 0.005) {
          value = target;
          velocity = 0;
          frame = 0;
          last = 0;
          write();
          return;
        }
        write();
        frame = requestAnimationFrame(step);
      };
      var follow = function () {
        target = progress();
        if (!frame && target !== value) frame = requestAnimationFrame(step);
      };
      var remeasure = function () {
        measure();
        follow();
      };
      measure();
      target = value = progress();
      write();
      document.documentElement.setAttribute('data-about-pen', '');
      window.addEventListener('scroll', follow, { passive: true });
      window.addEventListener('resize', remeasure);
      // The page settling (the faces arriving, a bio of another length)
      // moves the autograph without a resize.
      var settle = typeof ResizeObserver === 'function' ? new ResizeObserver(remeasure) : null;
      if (settle) settle.observe(page);
      document.addEventListener(
        'astro:before-swap',
        function () {
          window.removeEventListener('scroll', follow);
          window.removeEventListener('resize', remeasure);
          if (settle) settle.disconnect();
          if (frame) cancelAnimationFrame(frame);
        },
        { once: true },
      );
    })();
  </script>
</Layout>
