---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import AboutPage from '../components/about/AboutPage';
import { sanityClient } from 'sanity:client';
import type { SiteSettings } from '../types';

const currentPath = Astro.url.pathname;

/**
 * Fetch the single siteSettings document from Sanity.
 * The timeline array and other global fields are managed there.
 * Falls back gracefully if no document exists yet.
 */
const rawSettings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    name,
    bio,
    "avatarUrl": avatar.asset->url,
    email,
    instagram,
    timeline[] {
      year,
      title,
      description
    }
  }
`);

const settings: SiteSettings = rawSettings ?? {};
---

<Layout
  title="About | Ryan"
  description="Photographic archive. Operator: Ryan Xu. Base: New York."
  ogImage={settings.avatarUrl ? `${settings.avatarUrl}?auto=format&w=1200&h=630&fit=crop&q=85` : undefined}
  dark={true}
>
  <Nav client:load currentPath={currentPath} />
  <AboutPage client:load settings={settings} />
</Layout>
