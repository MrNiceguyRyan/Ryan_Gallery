---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import AboutPage from '../components/about/AboutPage';
import { sanityClient } from 'sanity:client';
import type { Collection, SiteSettings } from '../types';
import { fetchSanityWithRetry } from '../lib/sanityFetch';

const currentPath = Astro.url.pathname;

/**
 * Fetch the single siteSettings document from Sanity.
 * The timeline array and other global fields are managed there.
 * Falls back gracefully if no document exists yet.
 */
const [rawSettings, archiveCollections] = await Promise.all([
  fetchSanityWithRetry(() => sanityClient.fetch<SiteSettings | null>(`
    *[_type == "siteSettings"][0] {
      name,
      bio,
      "avatarUrl": avatar.asset->url,
      email,
      instagram,
      timeline[] {
        year,
        title,
        description
      }
    }
  `)),
  fetchSanityWithRetry(() => sanityClient.fetch<Array<Pick<Collection, '_id' | 'name' | 'location' | 'year' | 'photoCount'>>>(`
    *[_type == "collection" && defined(year)] | order(year desc, name asc) {
      _id,
      name,
      location,
      year,
      "photoCount": count(*[_type == "photo" && references(^._id)])
    }
  `)),
]);

const settings: SiteSettings = rawSettings ?? {};
---

<Layout
  title="About | Ryan"
  description="Photographic archive. Operator: Ryan Xu. Base: New York."
  ogImage={settings.avatarUrl ? `${settings.avatarUrl}?auto=format&w=1200&h=630&fit=crop&q=85` : undefined}
  dark={true}
>
  <Nav client:load currentPath={currentPath} />
  <AboutPage client:load settings={settings} collections={archiveCollections} />
</Layout>
