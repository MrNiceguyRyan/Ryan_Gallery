---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import { sanityClient } from 'sanity:client';
import type { Collection } from '../types';
import MapboxMap from '../components/MapboxMap';
import TravelEntryCover from '../components/TravelEntryCover';
import { getMapboxToken } from '../config/mapbox';
import { fetchSanityWithRetry } from '../lib/sanityFetch';
import { travelChapters } from '../lib/travelSilver';
import { pad2 } from '../lib/proofSheet';
import { COLLECTION_ZH_FIELDS, allWithZh } from '../i18n/content';
import { i18nAttrs, tr } from '../i18n/dict';
import T from '../i18n/T.astro';

const currentPath = Astro.url.pathname;

// The same archive the homepage reads, in the same order and numbering: the
// chapters (routeOrder), each chapter's cover (the photograph its ticket
// prints) and every frame at its own size and place.
const collections = await fetchSanityWithRetry(() => sanityClient.fetch<Collection[]>(`
  *[_type == "collection"] | order(year desc) {
    _id,
    name,
    "slug": slug.current,
    "coverImageUrl": coverImage.asset->url,
    location,
    region,
    year,
    routeOrder,
    mapLocation,
    ${COLLECTION_ZH_FIELDS},
    "photos": *[_type == "photo" && references(^._id)] | order(_createdAt desc) {
      _id,
      "imageUrl": image.asset->url,
      "width": image.asset->metadata.dimensions.width,
      "height": image.asset->metadata.dimensions.height,
      location
    }
  }
`));

// Their Chinese (names, regions, the frames' places) resolved once, here, so
// the islands print both languages (src/i18n/content.ts).
const chapters = travelChapters(allWithZh(collections));
const mapboxToken = getMapboxToken();

// ── The edition's figures (the homepage prologue's own: chapters, frames,
// years) — "07 locations" counted New York's two corners as two chapters. ──
const frames = chapters.reduce((sum, chapter) => sum + chapter.frames.length, 0);
const yearValues = [...new Set(chapters.map((chapter) => chapter.year).filter(Boolean))].sort();
const years = yearValues.length > 1 ? `${yearValues[0]}–${yearValues[yearValues.length - 1]}` : (yearValues[0] ?? '');
const ogPhoto = chapters[0]?.coverUrl;

// The headline in each language: the lime word is {accent} in the sentence,
// wherever the language puts it (为档案制图。).
const headline = (['en', 'zh'] as const).map((lang) => {
  const [before, after = ''] = tr(lang, 'travel.title').split('{accent}');
  return { lang, before, accent: tr(lang, 'travel.titleAccent'), after };
});
---

<Layout title={tr('en', 'travel.meta.title')} description={tr('en', 'travel.meta.description')} titleZh={tr('zh', 'travel.meta.title')} descriptionZh={tr('zh', 'travel.meta.description')} dark={true} ogImage={ogPhoto ? `${ogPhoto}?auto=format&w=1200&h=630&fit=crop&q=85` : undefined}>
  {/* Mapbox-only connection hints. Its CSS ships with the island so ClientRouter
       navigation cannot start the map before its styles are available. */}
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <link rel="preconnect" href="https://events.mapbox.com" crossorigin />
  </Fragment>

  <TravelEntryCover client:load chapters={chapters.length} frames={frames} />
  <Nav client:load currentPath={currentPath} scrim />

  <!-- The standalone Atlas is a fixed exploration workspace. The masthead and
       map share one viewport; only the location rail / mobile sheet can scroll. -->
  <main
    id="main-content"
    tabindex="-1"
    class="travel-workspace relative flex h-[100dvh] min-h-0 flex-col overflow-hidden bg-[#282c20]"
    data-travel-workspace
  >
    <!-- The masthead is bottom-aligned, so its own height is what clears the
         fixed nav. At the previous height the eyebrow landed at ~68px, inside
         the nav's ~90px scrim band, which greyed "The Territory · Geographic
         Index" almost out of existence (worse on mobile, where the title
         wraps). -->
    <header
      class="travel-workspace__masthead safe-inline-page relative z-10 h-[clamp(11.75rem,21svh,13rem)] shrink-0 overflow-hidden"
      data-travel-hero
      style="padding-top: calc(4.7rem + env(safe-area-inset-top));"
    >
      <!-- No lime wash behind the masthead: its one lime is "Archive." -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-b from-[#282c20]/88 to-transparent" aria-hidden="true"></div>

      <div class="travel-workspace__masthead-inner relative flex h-full items-end justify-between gap-8 pb-3 md:pb-4">
        <div class="min-w-0">
          <!-- Each phrase stays whole: with plain wrapping the two spans broke
               mid-phrase ("…Territory ·" / "Geographic Index"), which only
               became visible once the masthead cleared the nav. -->
          <p class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 font-ui text-[9px] uppercase tracking-[0.1em] text-white/56 md:tracking-[0.1em]">
            <span class="whitespace-nowrap"><T k="travel.eyebrow" /></span>
            <span class="whitespace-nowrap xl:hidden"><T k="travel.eyebrowFigures" vars={{ chapters: pad2(chapters.length), frames }} /></span>
          </p>
          <h1 class="travel-workspace__title font-serif text-[clamp(1.85rem,8.3vw,2.45rem)] uppercase leading-[0.86] tracking-tight text-[#F4F4ED] md:text-[clamp(2.6rem,4.8vw,4.15rem)]">
            {headline.map(({ lang, before, accent, after }) => (
              <span data-l={lang} lang={lang === 'zh' ? 'zh-Hans' : undefined}>{before}<span style="color: rgb(var(--accent-r), var(--accent-g), var(--accent-b));">{accent}</span>{after}</span>
            ))}
          </h1>
        </div>

        <div class="mb-0.5 hidden shrink-0 items-center gap-4 font-ui text-[9px] uppercase tracking-[0.1em] text-white/58 xl:flex">
          <span class="flex items-center gap-2.5">
            {/* A legend for the map's marks, drawn in their ink: the hollow
                 ring every chapter stands on. The page's one lime mark is
                 "Archive." above; everything the map says is ink and bone. */}
            <span class="travel-legend-ring" aria-hidden="true"></span>
            <span><T k="travel.legend" vars={{ chapters: pad2(chapters.length), frames: pad2(frames) }} />{years ? ` · ${years}` : ''}</span>
          </span>
        </div>
      </div>
    </header>

    <section
      id="atlas-map"
      class="relative -mt-2 mx-auto flex min-h-0 w-full max-w-[1920px] flex-1 px-0 pb-0 md:-mt-3 md:px-5 md:pb-5 xl:px-6"
      {...i18nAttrs({ 'aria-label': 'travel.mapAria' })}
    >
      {/* This region owns every remaining pixel in the viewport. Map gestures
           stay fully enabled; list and detail surfaces isolate their scrolling. */}
      <div class="min-h-0 flex-1" data-lenis-prevent>
        <MapboxMap client:load chapters={chapters} mapboxToken={mapboxToken} />
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* 中: the headline is one line (为档案制图。). The Han leading floor
     (global.css "Chinese type", 1.32) is for lines that stack; on this one
     it only added a third of an em over the headline, and the masthead is
     bottom-aligned at a fixed height, so it pushed the eyebrow up into the
     nav's scrim band the masthead's height was set to clear. */
  .travel-workspace__title [data-l='zh'] {
    line-height: 1;
  }

  @media (max-width: 1023px) and (max-height: 520px) and (orientation: landscape) {
    .travel-workspace .atlas-mobile-sheet {
      max-height: min(62svh, calc(100% - 4.5rem)) !important;
    }

    .travel-workspace .atlas-map-workspace[data-mobile-sheet='browse'] .atlas-mobile-sheet {
      height: 48svh !important;
    }

    .travel-workspace .atlas-map-workspace[data-mobile-sheet='detail'] .atlas-mobile-sheet {
      height: 62svh !important;
    }
  }
</style>
