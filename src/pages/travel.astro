---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import { sanityClient } from '../lib/sanityClient';
import type { Photo } from '../types';
import MapboxMap from '../components/MapboxMap';
import TravelEntryCover from '../components/TravelEntryCover';
import { getMapboxToken } from '../config/mapbox';
import { fetchSanityWithRetry } from '../lib/sanityFetch';

const currentPath = Astro.url.pathname;

const photos = await fetchSanityWithRetry(() => sanityClient.fetch<Photo[]>(`
  *[_type == "photo" && defined(location.lat) && defined(location.lng)] | order(_createdAt desc) {
    _id,
    title,
    "imageUrl": image.asset->url,
    location,
    collection->{
      name,
      "slug": slug.current,
      region
    }
  }
`));

const mapboxToken = getMapboxToken();

// ── Live atlas stats (derived from the same fetch, no extra query) ──
const frames = photos.length;
const locations = new Set(
  photos
    .filter((p) => p.location?.lat != null && p.location?.lng != null)
    .map((p) => `${p.location!.lat.toFixed(2)},${p.location!.lng.toFixed(2)}`)
).size;
---

<Layout title="Map | Ryan" description="Geo-tagged photographic archive. Every frame placed on the map across the United States." dark={true} ogImage={photos[0]?.imageUrl ? `${photos[0].imageUrl}?auto=format&w=1200&h=630&fit=crop&q=85` : undefined}>
  {/* Mapbox-only connection hints. Its CSS ships with the island so ClientRouter
       navigation cannot start the map before its styles are available. */}
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <link rel="preconnect" href="https://events.mapbox.com" crossorigin />
  </Fragment>

  <TravelEntryCover client:load locations={locations} frames={frames} />
  <Nav client:load currentPath={currentPath} scrim />

  <!-- The standalone Atlas is a fixed exploration workspace. The masthead and
       map share one viewport; only the location rail / mobile sheet can scroll. -->
  <main
    id="main-content"
    tabindex="-1"
    class="travel-workspace relative flex h-[100dvh] min-h-0 flex-col overflow-hidden bg-[#282c20]"
    data-travel-workspace
  >
    <header
      class="travel-workspace__masthead safe-inline-page relative z-10 h-[clamp(9.5rem,17svh,10.75rem)] shrink-0 overflow-hidden"
      data-travel-hero
      style="padding-top: calc(4.7rem + env(safe-area-inset-top));"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-70"
        style="background: radial-gradient(64rem 20rem at 70% 105%, rgba(var(--accent-r),var(--accent-g),var(--accent-b),0.065), transparent 70%);"
        aria-hidden="true"
      ></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-b from-[#282c20]/88 to-transparent" aria-hidden="true"></div>

      <div class="travel-workspace__masthead-inner relative flex h-full items-end justify-between gap-8 pb-3 md:pb-4">
        <div class="min-w-0">
          <p class="mb-1.5 flex items-center gap-2 font-ui text-[9px] uppercase tracking-[0.32em] text-white/56 md:tracking-[0.4em]">
            <span>The Territory · Geographic Index</span>
            <span class="xl:hidden">· {locations} locations · {frames} frames</span>
          </p>
          <h1 class="travel-workspace__title font-serif text-[clamp(1.85rem,8.3vw,2.45rem)] uppercase leading-[0.86] tracking-tight text-[#F4F4ED] md:text-[clamp(2.6rem,4.8vw,4.15rem)]">
            Mapping the <span style="color: rgb(var(--accent-r), var(--accent-g), var(--accent-b));">Archive.</span>
          </h1>
        </div>

        <div class="mb-0.5 hidden shrink-0 items-center gap-4 font-ui text-[9px] uppercase tracking-[0.2em] text-white/58 xl:flex">
          <span class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[rgb(var(--accent-r),var(--accent-g),var(--accent-b))] shadow-[0_0_12px_rgba(var(--accent-r),var(--accent-g),var(--accent-b),0.45)]"></span>
            {String(locations).padStart(2, '0')} locations · {String(frames).padStart(2, '0')} frames
          </span>
        </div>
      </div>
    </header>

    <section
      id="atlas-map"
      class="relative -mt-2 mx-auto flex min-h-0 w-full max-w-[1920px] flex-1 px-0 pb-0 md:-mt-3 md:px-5 md:pb-5 xl:px-6"
      aria-label="Interactive photographic atlas"
    >
      {/* This region owns every remaining pixel in the viewport. Map gestures
           stay fully enabled; list and detail surfaces isolate their scrolling. */}
      <div class="min-h-0 flex-1" data-lenis-prevent>
        <MapboxMap client:load photos={photos} mapboxToken={mapboxToken} />
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  @media (max-width: 1023px) and (max-height: 520px) and (orientation: landscape) {
    .travel-workspace .atlas-mobile-sheet {
      max-height: min(62svh, calc(100% - 4.5rem)) !important;
    }

    .travel-workspace .atlas-map-workspace[data-mobile-sheet='browse'] .atlas-mobile-sheet {
      height: 48svh !important;
    }

    .travel-workspace .atlas-map-workspace[data-mobile-sheet='detail'] .atlas-mobile-sheet {
      height: 62svh !important;
    }
  }
</style>
