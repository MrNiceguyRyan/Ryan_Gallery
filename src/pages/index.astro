---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import type { Collection } from '../types';
import HomePage from '../components/home/HomePage';
import OpeningFilm from '../components/home/OpeningFilm';
import { reelHeadScript } from '../lib/reelVisit';
import '../styles/opening.css';
import { fetchSanityWithRetry } from '../lib/sanityFetch';

// ─── GROQ: All collections with photos + location data ───
const collectionsQuery = `
  *[_type == "collection"] | order(year desc) {
    _id,
    name,
    "slug": slug.current,
    subtitle,
    "coverImageUrl": coverImage.asset->url,
    location,
    region,
    year,
    routeOrder,
    mapLocation,
    description,
    introduction,
    "photoCount": count(*[_type == "photo" && references(^._id)]),
    "photos": *[_type == "photo" && references(^._id)] | order(_createdAt desc) {
      _id,
      title,
      "imageUrl": image.asset->url,
      "width": image.asset->metadata.dimensions.width,
      "height": image.asset->metadata.dimensions.height,
      camera,
      focalLength,
      aperture,
      shutterSpeed,
      iso,
      styleCategory,
      location
    }
  }
`;

const collections = await fetchSanityWithRetry(() =>
  sanityClient.fetch<Collection[]>(collectionsQuery),
);
---

<Layout dark={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    {/* The opening film covers the first screen from the first paint: say so
        before anything paints (html[data-opening] shows its layer, the first
        screen's entrance waits under it). On a second view in the same tab
        session it is skipped instead (data-reel="skip": the layer is not
        shown and the page opens on the first screen), src/lib/reelVisit.ts. */}
    <script is:inline set:html={reelHeadScript()} />
  </Fragment>
  {/* The opening film: a word hunt through many texts, over the page. Its
      first scene is the server's markup, so it is the first paint. */}
  <OpeningFilm client:load />
  <HomePage client:load collections={collections} />
</Layout>
