---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import type { Collection } from '../types';
import HomePage from '../components/home/HomePage';
import OpeningFilm from '../components/home/OpeningFilm';
import { reelHeadScript } from '../lib/reelVisit';
import { pickPictures } from '../lib/openingFilm';
import '../styles/opening.css';
import '../styles/entrance.css';
import { fetchSanityWithRetry } from '../lib/sanityFetch';
import { withSampleChapters } from '../lib/storyChaptersSample';

// ─── GROQ: All collections with photos + location data ───
// `chapters`: the story's optional sub-chapters, each with its photographs as
// ids; the story finds them among `photos` (src/lib/storyChapters.ts), so a
// photograph is projected once and a reference to anything that is not this
// collection's is simply not found.
const collectionsQuery = `
  *[_type == "collection"] | order(year desc) {
    _id,
    name,
    "slug": slug.current,
    subtitle,
    "coverImageUrl": coverImage.asset->url,
    location,
    region,
    year,
    routeOrder,
    mapLocation,
    description,
    introduction,
    "chapters": chapters[defined(title)] {
      _key,
      title,
      shortTitle,
      kicker,
      intro,
      "photoIds": photos[]._ref
    },
    "photoCount": count(*[_type == "photo" && references(^._id)]),
    "photos": *[_type == "photo" && references(^._id)] | order(_createdAt desc) {
      _id,
      title,
      "imageUrl": image.asset->url,
      "width": image.asset->metadata.dimensions.width,
      "height": image.asset->metadata.dimensions.height,
      camera,
      focalLength,
      aperture,
      shutterSpeed,
      iso,
      styleCategory,
      location
    }
  }
`;

// A STORY_CHAPTERS_SAMPLE=1 preview build prints one story in placeholder
// chapters (src/lib/storyChaptersSample.ts); every other build as fetched.
const fetchedCollections = await fetchSanityWithRetry(() =>
  sanityClient.fetch<Collection[]>(collectionsQuery),
);
const collections = Array.isArray(fetchedCollections)
  ? fetchedCollections.map((collection) => withSampleChapters(collection))
  : fetchedCollections;
// Three of his frames for the film (the pill's life, the grid paper's
// print, the magazine's plate), each at its own ratio.
const openingPictures = pickPictures(Array.isArray(collections) ? collections : []);
---

<Layout dark={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    {/* The opening film covers the first screen from the first paint: say so
        before anything paints (html[data-opening] shows its layer, the
        opening words' entrance waits under it). On a second view in the same
        tab session it is skipped instead (data-reel="skip": the layer is not
        shown and the page opens on the opening words), src/lib/reelVisit.ts. */}
    <script is:inline set:html={reelHeadScript()} />
  </Fragment>
  {/* The opening film: a retro editorial type film, over the page. Its
      first frame (a dark CRT, a blinking cursor) is the server's markup, so
      it is the first paint. */}
  <OpeningFilm client:load pictures={openingPictures} />
  <HomePage client:load collections={collections} />
</Layout>
