---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import type { Collection } from '../types';
import HomePage from '../components/home/HomePage';
import IntroReel from '../components/home/IntroReel';
import { reelCoverMarkup } from '../lib/introReelCover';
import { PHONE_MAX_WIDTH, REEL_DESKTOP, REEL_PHONE } from '../lib/introReel';
import { reelHeadScript } from '../lib/reelVisit';
import { fetchSanityWithRetry } from '../lib/sanityFetch';

// ─── GROQ: All collections with photos + location data ───
const collectionsQuery = `
  *[_type == "collection"] | order(year desc) {
    _id,
    name,
    "slug": slug.current,
    subtitle,
    "coverImageUrl": coverImage.asset->url,
    location,
    region,
    year,
    routeOrder,
    mapLocation,
    description,
    introduction,
    "photoCount": count(*[_type == "photo" && references(^._id)]),
    "photos": *[_type == "photo" && references(^._id)] | order(_createdAt desc) {
      _id,
      title,
      "imageUrl": image.asset->url,
      "width": image.asset->metadata.dimensions.width,
      "height": image.asset->metadata.dimensions.height,
      camera,
      focalLength,
      aperture,
      shutterSpeed,
      iso,
      styleCategory,
      location
    }
  }
`;

const collections = await fetchSanityWithRetry(() =>
  sanityClient.fetch<Collection[]>(collectionsQuery),
);
---

<Layout dark={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    {/* The opening reel covers the first screen from the first paint: say so
        before anything paints (the nav's wordmark goes on its ink pill, the
        first screen's entrance waits for the shutter). IntroReel keeps it.
        On a second view in the same tab session it is skipped instead
        (data-reel="skip": CSS collapses it and the page opens on the first
        screen), src/lib/reelVisit.ts. */}
    <script
      is:inline
      set:html={reelHeadScript({ desktopScreens: REEL_DESKTOP.screens, phoneScreens: REEL_PHONE.screens, phoneMaxWidth: PHONE_MAX_WIDTH })}
    />
  </Fragment>
  {/* The opening film, pinned over the top of the page; its cover is drawn
      here, on the server, so it is the first paint. */}
  <IntroReel client:load>
    <Fragment set:html={reelCoverMarkup()} />
  </IntroReel>
  <HomePage client:load collections={collections} />
</Layout>
