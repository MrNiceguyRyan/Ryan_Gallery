---
// /notes — the owner's column: every published note, newest first. Up to
// three, each is a full entry (number, date, title, dek, the places it is
// about as tickets on each chapter's stock, the cover at its own ratio); from
// four on, the newest leads and the rest are contents rows (planList). With
// nothing published it is a quiet page that nothing links to (the nav's NOTES
// appears with the first note).
// 中 / EN: every label and date in both languages, a note's title and dek
// beside their Chinese twins where he wrote them (src/i18n/runtime.ts).
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav';
import PlaceTags from '../../components/notes/PlaceTags.astro';
import NotesScroll from '../../components/notes/NotesScroll.astro';
import '../../styles/notes.css';
import { sanityClient } from 'sanity:client';
import { fetchSanityWithRetry } from '../../lib/sanityFetch';
import { loadNotes } from '../../lib/notesData';
import CjkSerifLink from '../../components/shared/CjkSerifLink.astro';
import {
  blockLang,
  formatNoteDateShort,
  imageSrcSet,
  imageSize,
  imageUrl,
  hasHan,
  isoDay,
  noteInChinese,
  noteNumbers,
  pad2,
  planList,
  readingMinutes,
  shareCardUrl,
} from '../../lib/notes';
import { siteText } from '../../i18n/content';
import { i18nAttrs, tr } from '../../i18n/dict';
import T from '../../i18n/T.astro';
import Bi from '../../i18n/Bi.astro';

const currentPath = Astro.url.pathname;
const { notes, sample } = await loadNotes();
const numbers = noteNumbers(notes);
const count = notes.length;
const rows = planList(notes);
const firstCover = notes.find((note) => note.cover)?.cover;
const ogImage = firstCover ? shareCardUrl(firstCover) : undefined;
const hasChinese = notes.some((note) => [note.title, note.dek, note.titleZh, note.dekZh].some(hasHan));
// The dek under the title: siteSettings.notesDek (and its Chinese) once he
// has written it, else the page's own line and our draft (siteText).
const settings = await fetchSanityWithRetry(() =>
  sanityClient.fetch<{ notesDek?: string; notesDekZh?: string } | null>(`*[_type == "siteSettings"][0] { notesDek, notesDekZh }`),
);
const DEK = siteText(settings).notesDek;
const numberOf = (slug: string) => pad2(numbers.get(slug) ?? 0);
const title = tr('en', 'notes.title');
const description = count ? tr('en', 'notes.description', { dek: DEK.en }) : tr('en', 'notes.descriptionEmpty');
const descriptionZh = count ? tr('zh', 'notes.description', { dek: DEK.zh ?? DEK.en }) : tr('zh', 'notes.descriptionEmpty');
// Both languages of a label whose figures differ by language.
const pair = (en: string, zh: string) => ({ en, zh });
---

<Layout
  title={title}
  description={description}
  titleZh={tr('zh', 'notes.title')}
  descriptionZh={descriptionZh}
  ogImage={ogImage || undefined}
  dark={true}
>
  <Fragment slot="head">
    {(count === 0 || sample) && <meta name="robots" content="noindex, follow" />}
    {hasChinese && <CjkSerifLink />}
  </Fragment>
  <Nav client:load currentPath={currentPath} scrim />
  <main
    id="main-content"
    tabindex="-1"
    class="notes-page"
    data-notes-page
    data-notes-list
    data-cjk-serif={hasChinese ? '' : undefined}
  >
    {/* The entrance is for an arrival from inside the site, decided once,
        here, before the page paints: never on the document's own first load
        (it runs then while the document is still parsing), never when a push
        or a fall already carried the page in (html[data-axis]). Without JS
        there is no attribute and the page is simply set. */}
    <script is:inline data-astro-rerun>
      (function () {
        var page = document.querySelector('[data-notes-page]');
        if (!page || document.readyState === 'loading' || document.documentElement.hasAttribute('data-axis')) return;
        page.setAttribute('data-notes-entry', 'play');
      })();
    </script>
    <header class="notes-mast n-grid">
      {/* /about's running head: the section on the left, the count on the
          right once there is more than one, a hairline under both. */}
      <div class="notes-runhead" data-enter="kicker">
        <span class="n-label n-label--ink font-ui"><T k="notes.runhead" /></span>
        {count > 1 && <span class="n-label font-ui"><T k="notes.count" vars={{ nn: pad2(count) }} /></span>}
        <span class="notes-runhead__rule" aria-hidden="true"></span>
      </div>
      <h1 class="notes-mast__title font-serif">
        <span class="note-title__line" data-enter="title"><T k="notes.h1" /></span>
      </h1>
      <p class="notes-mast__dek font-serif" data-enter="dek"><Bi en={DEK.en} zh={DEK.zh} /></p>
    </header>

    {count > 0 ? (
      <ol class="notes-list" {...i18nAttrs({ 'aria-label': 'notes.listAria' })} data-enter="credits">
        {rows.map((row, index) => {
          const note = row.note;
          const date = pair(formatNoteDateShort(note.publishedAt), formatNoteDateShort(note.publishedAt, 'zh'));
          if (row.kind === 'row') {
            return (
              <li class:list={['notes-row n-grid', row.yearBefore && 'notes-row--year']}>
                {row.yearBefore && <span class="notes-row__year n-label n-label--ink font-ui">{row.yearBefore}</span>}
                <div class="notes-row__rule" aria-hidden="true"></div>
                <div class="notes-row__meta">
                  <span class="n-label n-label--ink font-ui"><T k="notes.number" vars={{ nn: numberOf(note.slug) }} /></span>
                  <time class="n-label font-ui" datetime={isoDay(note.publishedAt)}><Bi en={date.en} zh={date.zh} /></time>
                </div>
                <h2 class="notes-row__title font-serif" lang={blockLang(note.title, note.titleZh)}>
                  <a class="notes-item__link" href={`/notes/${note.slug}`} data-astro-prefetch><Bi en={note.title} zh={note.titleZh} /></a>
                </h2>
                <PlaceTags places={note.places} raised />
              </li>
            );
          }
          const size = note.cover ? imageSize(note.cover) : null;
          const minutes = pair(
            tr('en', 'notes.minRead', { n: readingMinutes(note) }),
            tr('zh', 'notes.minRead', { n: readingMinutes(noteInChinese(note)) }),
          );
          return (
            <li class:list={['notes-item n-grid', row.kind === 'lead' && 'notes-item--lead']}>
              <div class="notes-item__rule" aria-hidden="true"></div>
              <div class="notes-item__meta">
                <span class="n-label n-label--ink font-ui"><T k="notes.number" vars={{ nn: numberOf(note.slug) }} /></span>
                <time class="n-label font-ui" datetime={isoDay(note.publishedAt)}><Bi en={date.en} zh={date.zh} /></time>
                <span class="n-label font-ui"><Bi en={minutes.en} zh={minutes.zh} /></span>
                {note.sample && <span class="n-label n-label--ink font-ui"><T k="notes.sample" /></span>}
              </div>
              <div class="notes-item__body">
                <h2 class="notes-item__title font-serif" lang={blockLang(note.title, note.titleZh)}>
                  <a class="notes-item__link" href={`/notes/${note.slug}`} data-astro-prefetch><Bi en={note.title} zh={note.titleZh} /></a>
                </h2>
                {note.dek && (
                  <p class="notes-item__dek font-serif" lang={blockLang(note.dek, note.dekZh)}><Bi en={note.dek} zh={note.dekZh} /></p>
                )}
                <PlaceTags places={note.places} raised />
              </div>
              {note.cover && size && (
                <figure class="notes-item__cover" style={`--r: ${(size.width / size.height).toFixed(5)}`}>
                  <img
                    src={imageUrl(note.cover, 640)}
                    srcset={imageSrcSet(note.cover, [240, 320, 480, 640, 960])}
                    sizes="(min-width: 1024px) 24vw, 96px"
                    width={size.width}
                    height={size.height}
                    alt=""
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                  />
                </figure>
              )}
            </li>
          );
        })}
      </ol>
    ) : (
      <section class="n-grid" {...i18nAttrs({ 'aria-label': 'notes.emptyAria' })}>
        <div class="notes-empty" data-enter="credits">
          <p class="notes-empty__line font-serif"><T k="notes.empty" /></p>
          <a class="n-textlink n-label font-ui" href="/"><T k="notes.backToArchive" /></a>
        </div>
      </section>
    )}
  </main>
  <NotesScroll />
</Layout>
