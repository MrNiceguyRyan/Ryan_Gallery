---
/**
 * AboutLab — a deliberately minimal, self-contained shell for the cinematic
 * About experience. Intentionally does NOT use the site's warm Layout
 * (global.css / Nav / Footer / ClientRouter): this page is its own B&W world
 * with its own chrome, and Lenis smooth-scroll must not fight view transitions.
 */
import '../styles/about/global.css';
import '../styles/about/typography.css';
import '../styles/about/sections.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'About — Ryan Xu', description = 'Multidisciplinary work. Make it last.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initAbout } from '../scripts/about/main.js';
      initAbout();
    </script>
  </body>
</html>
