---
// Keep Mapbox's base styles across ClientRouter head swaps. A cached lazy
// island does not re-run its CSS side effect when returning to the Homepage.
import 'mapbox-gl/dist/mapbox-gl.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  dark?: boolean;
  /** Page-specific JSON-LD blocks (e.g. ImageObject for a collection page).
   *  Concatenated with the default Person + WebSite blocks. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Ryan | Visual Archive',
  description = 'A curated collection of photographic moments — shot on Nikon Zf, engineered with intention.',
  ogImage = 'https://cdn.sanity.io/images/z610fooo/production/e69f9258142218c5cd649a9c01d4fe89d0335563-6048x4032.jpg?auto=format&w=1200&h=630&fit=crop&q=85',
  ogType = 'website',
  dark = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://ryanxugallery.com');
const siteUrl = (Astro.site ?? new URL('https://ryanxugallery.com')).toString().replace(/\/$/, '');

// ─── Default JSON-LD: Person (Ryan Xu) + WebSite ───
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ryan Xu',
  url: siteUrl,
  jobTitle: 'Photographer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New York',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.instagram.com/ryan_photoo/',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ryan Xu — Visual Archive',
  url: siteUrl,
  inLanguage: 'en-US',
};

const pageJsonLd = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];
const allJsonLd = [personSchema, websiteSchema, ...pageJsonLd];

// ─── Optional hub link (rel=me + footer link) ───
// Driven by PUBLIC_HUB_URL env var. Hidden when not set.
const hubUrl = import.meta.env.PUBLIC_HUB_URL || '';
const showGlobalSkipLink = Astro.url.pathname !== '/';
const travelWorkspaceActive = Astro.url.pathname.replace(/\/+$/, '') === '/travel';
---

<html lang="en" class:list={[travelWorkspaceActive && 'travel-workspace-active']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Sanity CDN — every image on the site comes through here, so warm the TLS */}
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {/* mapbox preconnect only on /travel */}
    {/* One combined request; dropped the unused Noto Sans SC (Chinese) family
        that was a ~91 KB render-blocking stylesheet for nothing. */}
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {/* Mapbox CSS is bundled with the Travel island; only its API hosts are preconnected there. */}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content={dark ? '#282c20' : '#ffffff'} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ryan Xu | Visual Archive" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* ── rel=me linking to the personal info hub (IndieAuth / Mastodon-style) ── */}
    {hubUrl && <link rel="me" href={hubUrl} />}

    {/* ── Structured data: Person + WebSite + page-specific blocks ── */}
    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Page-specific <head> injections (preconnects, stylesheets) */}
    <slot name="head" />

    <!-- Astro View Transitions — smooth page navigation -->
    <ClientRouter />
  </head>

  <body class:list={[
    "min-h-screen font-sans antialiased overflow-x-hidden",
    dark ? "bg-[#282c20] text-[#F4F4ED]" : "bg-white text-gray-900",
    travelWorkspaceActive && "travel-workspace-active"
  ]}>
    {showGlobalSkipLink && (
      <a
        href="#main-content"
        class="fixed left-4 top-4 z-[100] inline-flex min-h-11 -translate-y-[160%] items-center rounded-full bg-[#F4F4ED] px-5 font-ui text-[10px] font-bold uppercase tracking-[0.2em] text-[#171b15] transition-transform duration-200 focus:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#D2FF00]"
      >
        Skip to content
      </a>
    )}
    <slot />

    {/* Global craft layers — a soft olive vignette for depth (behind content) and
        a fine STATIC film grain over everything (fixed, pointer-events-none, no
        animation → no flicker). The whole archive reads like film prints. */}
    <div class="page-vignette" aria-hidden="true"></div>
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Global image protection: prevent right-click, drag, long-press save, and print -->
    <style is:global>
      img {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
        pointer-events: auto;
        -webkit-user-drag: none;
        -khtml-user-drag: none;
        -moz-user-drag: none;
        -o-user-drag: none;
      }

      /* Mobile-only: prevent rubber-band bounce on the body so atmospheric
         fixed elements (video, sunbeam, grid) don't drift on iOS, and stop
         double-tap zoom which fights the cinematic transitions. */
      html, body {
        overscroll-behavior-y: none;
      }
      /* Touch devices don't get hover, so they shouldn't pay for cursor:none */
      @media (hover: none) {
        body { touch-action: manipulation; }
      }

      /* When printing, hide all images so a Save → Print → PDF route doesn't
         yield clean copies. Show a watermark in their place. */
      @media print {
        img, video, canvas, svg { display: none !important; }
        body::before {
          content: "© Ryan Xu · ryanxugallery.com — viewing copy, not for distribution.";
          display: block;
          padding: 2rem;
          font-family: ui-monospace, monospace;
          font-size: 12px;
          color: #444;
        }
      }

      /* ═══════════════════════════════════════════════════════
       *  Directional Page Transition — "Card Stack" model
       *  — Forward (click into a page): NEW page slides UP from below
       *    (pops up on top of the current card)
       *  — Back (leave / return):        OLD page slides DOWN off screen
       *    (the top card falls, revealing the card behind)
       *  Compositor-only transforms; no blur/box-shadow → smooth even
       *  while leaving heavy pages (e.g. /travel with Mapbox).
       * ═══════════════════════════════════════════════════════ */

      /* ─────────────────────────────────────────────────
       *  Default root swap — no animation. Directional motion is opted into
       *  per-navigation via html[data-axis] (below): "enter" depth-zoom for
       *  standard sections and "forward"/"back" for lateral siblings.
       *  Everything else (e.g. →Home via the DIY slide-down) swaps instantly.
       *  ───────────────────────────────────────────────── */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }

      /* ───────────────────────────────────────────────
       *  Lateral sibling nav (Map ↔ About) — shared-axis push.
       *
       *  Apple / Material-grade peer-tab transition: the incoming page
       *  slides in OPAQUE over the outgoing one, which parallax-drifts the
       *  other way and dims. No full-screen masthead — switching between
       *  two peer sections should feel like a continuous spatial move, not
       *  an interruption. Direction (`forward` / `back`) is set on <html>
       *  by JS from the route order, and re-asserted in astro:after-swap
       *  (Astro wipes root attributes during the DOM swap).
       *  ─────────────────────────────────────────────── */
      html[data-axis]::view-transition-old(root) { z-index: 1; }
      html[data-axis]::view-transition-new(root) { z-index: 2; }

      html[data-axis="forward"]::view-transition-old(root) {
        animation: sa-old-fwd 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      html[data-axis="forward"]::view-transition-new(root) {
        animation: sa-new-fwd 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      html[data-axis="back"]::view-transition-old(root) {
        animation: sa-old-back 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      html[data-axis="back"]::view-transition-new(root) {
        animation: sa-new-back 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      /* Quiet shared-axis movement. Keep it compositor-only: the earlier
         20px blur + 60% travel looked flashy and made Mapbox exits expensive. */
      @keyframes sa-old-fwd  {
        0%   { transform: translateX(0); opacity: 1; }
        100% { transform: translateX(-14%); opacity: 0.28; }
      }
      @keyframes sa-new-fwd  {
        0%   { transform: translateX(14%); opacity: 0.28; }
        100% { transform: translateX(0); opacity: 1; }
      }
      @keyframes sa-old-back {
        0%   { transform: translateX(0); opacity: 1; }
        100% { transform: translateX(14%); opacity: 0.28; }
      }
      @keyframes sa-new-back {
        0%   { transform: translateX(-14%); opacity: 0.28; }
        100% { transform: translateX(0); opacity: 1; }
      }

      /* ───────────────────────────────────────────────
       *  Enter a section from Home (Home → Map / About) — Apple depth zoom.
       *
       *  A strong, intuitive "push forward into the destination": the new
       *  page grows gently from smaller to full while fading in; the Home
       *  page recedes by a few percent. Reads as moving into the content,
       *  not sliding next
       *  to it. (Map↔About stays lateral; this is descent into depth.)
       *  ─────────────────────────────────────────────── */
      html[data-axis="enter"]::view-transition-old(root) {
        animation: enter-old 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
        transform-origin: 50% 46%;
      }
      html[data-axis="enter"]::view-transition-new(root) {
        animation: enter-new 0.54s cubic-bezier(0.16, 1, 0.3, 1) both;
        transform-origin: 50% 46%;
      }
      @keyframes enter-old {
        0%   { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.045); }
      }
      @keyframes enter-new {
        0%   { opacity: 0; transform: scale(0.975); }
        100% { opacity: 1; transform: scale(1); }
      }

      /* Reduced-motion: disable the directional view transitions. */
      @media (prefers-reduced-motion: reduce) {
        html[data-axis]::view-transition-old(root),
        html[data-axis]::view-transition-new(root) {
          animation: none !important;
        }
      }

      /* Back-nav slide-down: applied to <body> via JS. Uses compositor-only
         `transform` so it stays smooth even with heavy pages (Mapbox etc.). */
      body.vt-back-exit {
        transition: transform 0.46s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.34s ease;
        transform: translateY(12vh);
        opacity: 0;
        will-change: transform, opacity;
      }

      /* Reduce motion: instant transition for accessibility */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>

    {/* Custom cursor removed — the native cursor is the cursor. Interactive
        elements use standard `cursor: pointer` affordance. */}

    <script>
      import { navigate } from 'astro:transitions/client';
      // The exit layer below is inline so it can intercept links in capture
      // phase. Hand the actual route change back to Astro once it has finished.
      (window as Window & { __galleryNavigate?: typeof navigate }).__galleryNavigate = navigate;
    </script>

    <script is:inline>
      // ── Image protection ──
      // Block right-click anywhere on a photo (img tag OR a container that
      // declares itself as wrapping a protected image via .work-photo-item /
      // [data-protected] / nodes inside the lightbox).
      function isProtectedTarget(t) {
        if (!t || !t.closest) return false;
        if (t.tagName === 'IMG') return true;
        return !!t.closest('img, .work-photo-item, [data-protected], #lightbox, .photo-cell');
      }
      document.addEventListener('contextmenu', function(e) {
        if (isProtectedTarget(e.target)) e.preventDefault();
      }, true);
      document.addEventListener('dragstart', function(e) {
        if (isProtectedTarget(e.target)) e.preventDefault();
      }, true);
      // Block Cmd/Ctrl + S (save page) and Cmd/Ctrl + P (print).
      // Power users can still bypass via DevTools — this is a deterrent
      // for casual saving, not a security boundary.
      document.addEventListener('keydown', function(e) {
        var mod = e.metaKey || e.ctrlKey;
        if (mod && (e.key === 's' || e.key === 'S' || e.key === 'p' || e.key === 'P')) {
          e.preventDefault();
        }
      }, true);

      // ── Back-nav slide-down (DIY, Framer-Motion exit={{y:"100%"}} pattern) ──
      // Why DIY: browsers' CSS View Transitions API proved unreliable for the
      // "old-page slides down while new-page holds" pattern across Astro's
      // ClientRouter swap. Instead, we cancel the ClientRouter navigation for
      // back-direction clicks, animate <body> down with a CSS transform, and
      // then do a normal navigation to the destination. The page beneath the
      // sliding body is the browser background — set to match the destination
      // (dark for home, light for light pages) so no jarring flash appears.
      //
      // This exit layer owns back-direction LINK CLICKS only. Browser history
      // remains owned by Astro, with its animation selected below by data-axis.
      (function() {
        var DUR = 460; // ms — must match CSS `body.vt-back-exit` transition
        var EXITING = false;
        var exitFrame = 0;
        var exitTimer = 0;

        function resetExit() {
          if (exitFrame) cancelAnimationFrame(exitFrame);
          if (exitTimer) clearTimeout(exitTimer);
          exitFrame = 0;
          exitTimer = 0;
          EXITING = false;
          document.body.classList.remove('vt-back-exit');
          document.documentElement.style.removeProperty('background-color');
        }

        function depth(path) { return path.split('/').filter(Boolean).length; }

        function pathOf(u) {
          if (!u) return '';
          if (typeof u === 'string') {
            try { return new URL(u, window.location.origin).pathname; }
            catch (e) { return u; }
          }
          return u.pathname || '';
        }

        function isBackTo(toPath) {
          if (!toPath) return false;
          if (toPath === '/') return true;
          // Link clicks are checked before Astro changes the current URL.
          return depth(toPath) < depth(window.location.pathname);
        }

        // Pick the canvas color revealed beneath the sliding body. This must
        // match the global page field exactly; using the slightly lighter
        // story surface here creates a visible horizontal band during return.
        function bgFor(toPath) {
          return '#282c20';
        }

        function navigateAfterExit(href, replace) {
          var clientNavigate = window.__galleryNavigate;
          if (typeof clientNavigate === 'function') {
            clientNavigate(href, { history: replace ? 'replace' : 'push' });
          } else {
            window.location.href = href;
          }
        }

        function runExit(href, bg, replace) {
          if (EXITING) return;
          // Reduced-motion: plain navigation. The CSS neutralizer collapses the
          // 0.55s slide to 0.001ms, which would otherwise park the body
          // off-screen (blank page) for the full DUR timeout.
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            navigateAfterExit(href, replace);
            return;
          }
          EXITING = true;
          // Paint the background the destination page will use, so the strip
          // exposed beneath the sliding body is the right color.
          document.documentElement.style.backgroundColor = bg;
          document.body.style.backgroundColor = getComputedStyle(document.body).backgroundColor || '';
          // Kick the animation on the next frame so the transition has a
          // clean starting state (transform:none → the short exit offset)
          exitFrame = requestAnimationFrame(function() {
            exitFrame = 0;
            document.body.classList.add('vt-back-exit');
          });
          exitTimer = setTimeout(function() {
            exitTimer = 0;
            navigateAfterExit(href, replace);
          }, DUR + 20);
        }

        // 1) Intercept "back"-direction link clicks BEFORE Astro's ClientRouter
        //    handler fires. Listener added on `document` in capture phase runs
        //    earlier than ClientRouter's delegated click handler.
        document.addEventListener('click', function(e) {
          if (EXITING) { e.preventDefault(); return; }
          if (e.defaultPrevented) return;
          if (e.button !== 0) return;                 // only primary click
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          if (a.target && a.target !== '' && a.target !== '_self') return;
          if (a.hasAttribute('download')) return;
          var href = a.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
          var url;
          try { url = new URL(href, window.location.origin); } catch (err) { return; }
          if (url.origin !== window.location.origin) return;
          var toPath = url.pathname;
          if (toPath === window.location.pathname) return;
          if (!isBackTo(toPath)) return;

          e.preventDefault();
          e.stopPropagation();
          runExit(url.pathname + url.search + url.hash, bgFor(toPath), false);
        }, true); // capture phase — run before ClientRouter

        // Astro already handles this same popstate. Rewriting its URL and
        // issuing a second navigate after a timeout races the real traversal.
        // Only cancel a pending click exit, so it cannot hide the incoming body
        // or redirect a subsequent Map -> About navigation back to Map.
        window.addEventListener('popstate', resetExit);
        document.addEventListener('astro:page-load', resetExit);
      })();

      // ── Filmstrip scroll restoration ──
      // Save scroll position when leaving Homepage. A direct Home link restores
      // it before the incoming transition snapshot; browser history traversal
      // keeps Astro's own stored scroll state instead of being overwritten.
      var restoreHomeScrollOnSwap = false;
      function readHomeFilmstripScroll() {
        var body = document.body;
        // An open Homepage Story fixes body at the negative archive offset;
        // window.scrollY is then zero. Reuse that actual lock position rather
        // than saving a new top-of-page position over the visitor's chapter.
        if (body.style.position === 'fixed') {
          var fixedTop = parseFloat(body.style.top || getComputedStyle(body).top);
          if (Number.isFinite(fixedTop)) return Math.max(0, -fixedTop);
        }
        return window.scrollY;
      }
      function transitionPath(value, fallback) {
        if (!value) return fallback;
        try { return new URL(value, window.location.origin).pathname; }
        catch (err) { return fallback; }
      }
      document.addEventListener('astro:before-preparation', function(e) {
        var fromPath = transitionPath(e && e.from, window.location.pathname);
        var toPath = transitionPath(e && e.to, window.location.pathname);
        if (fromPath === '/' && toPath !== '/') {
          sessionStorage.setItem('home-filmstrip-scroll', String(readHomeFilmstripScroll()));
        }
        restoreHomeScrollOnSwap = toPath === '/' && (!e || e.navigationType !== 'traverse');
      });
      document.addEventListener('astro:before-swap', function(e) {
        var fromPath = transitionPath(e && e.from, window.location.pathname);
        var toPath = transitionPath(e && e.to, window.location.pathname);
        if (fromPath !== '/' || toPath === '/' || e.navigationType === 'traverse' || !history.state) return;
        // Astro has finished sampling scroll by this point but has not pushed
        // the destination entry yet. Correct the existing Home entry so native
        // Back restores it too; never overwrite the destination of a traversal.
        history.replaceState(Object.assign({}, history.state, { scrollY: readHomeFilmstripScroll() }), '');
      });
      function restoreHomeFilmstrip() {
        if (restoreHomeScrollOnSwap && window.location.pathname === '/') {
          restoreHomeScrollOnSwap = false;
          var saved = sessionStorage.getItem('home-filmstrip-scroll');
          if (saved) {
            sessionStorage.removeItem('home-filmstrip-scroll');
            var y = parseInt(saved, 10);
            // Only restore if user was past the hero (i.e., in the filmstrip area)
            if (y > 100) {
              // after-swap runs before the browser captures the incoming View
              // Transition snapshot. Restore now so Home never appears at the
              // top and then jumps to the visitor's previous chapter.
              window.scrollTo({ top: y, behavior: 'instant' });
            }
          }
        }
      }
      document.addEventListener('astro:after-swap', restoreHomeFilmstrip);

      // ── Page-transition direction (View Transitions) ──
      // Sets html[data-axis] from the route relationship so the global
      // ::view-transition(root) rules animate the right way:
      //   Home → Map      : Atlas editorial cover (TravelEntryCover)
      //   Map → Home      : the same downward return used by About
      //   Home → About    : contributor cover (AboutPage)
      //   Map ↔ About      : shared-axis push ("forward" / "back")
      // (Other back routes retain the DIY body slide-down; opening a story is
      // the React MagazineLayout cover.)
      (function() {
        function normalize(path) {
          if (!path) return '/';
          if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
          return path;
        }

        // Route order for lateral sibling nav (Map ↔ About).
        var LATERAL = { '/travel': 1, '/about': 2 };
        var pendingAxis = null; // 'forward' | 'back'

        document.addEventListener('astro:before-preparation', function(e) {
          if (!(e && e.to)) return;
          var toPath = '';
          try { toPath = new URL(e.to, window.location.origin).pathname; }
          catch (err) { return; }
          var fromPath = window.location.pathname;
          try {
            if (e.from) fromPath = new URL(e.from, window.location.origin).pathname;
          } catch (err) {}
          var nf = normalize(fromPath);
          var nt = normalize(toPath);
          document.documentElement.removeAttribute('data-axis');
          pendingAxis = null;
          if (nt === nf) return;

          // Lateral sibling nav (Map ↔ About): shared-axis push.
          if (LATERAL[nf] && LATERAL[nt]) {
            pendingAxis = LATERAL[nt] > LATERAL[nf] ? 'forward' : 'back';
            document.documentElement.setAttribute('data-axis', pendingAxis);
            return;
          }

          // Browser Back keeps Astro's original target, history state and
          // single navigation. Reuse the existing back animation without the
          // link-click exit layer starting another route change.
          if (e.navigationType === 'traverse' && e.direction === 'back') {
            pendingAxis = 'back';
            document.documentElement.setAttribute('data-axis', pendingAxis);
            return;
          }

          // When entering either primary destination from elsewhere, its own
          // editorial cover remains the single handoff. This check must follow
          // the sibling case above or Map ↔ About can never receive an axis.
          if (nt === '/about' || nt === '/travel') return;

        });

        // Astro wipes <html> attributes during the DOM swap, so the axis set
        // in before-preparation is gone by the time the browser computes the
        // ::view-transition animation. astro:after-swap runs synchronously
        // inside the view-transition update callback (after the attribute
        // wipe, before the new snapshot is styled) — re-assert it here.
        document.addEventListener('astro:after-swap', function() {
          if (pendingAxis) {
            document.documentElement.setAttribute('data-axis', pendingAxis);
          }
        });
      })();
    </script>
  </body>
</html>
