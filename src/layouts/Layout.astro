---
// Keep Mapbox's base styles across ClientRouter head swaps. A cached lazy
// island does not re-run its CSS side effect when returning to the Homepage.
import 'mapbox-gl/dist/mapbox-gl.css';
// The two webfonts' rules (Google's own, the same files from fonts.gstatic.com):
// in the page's stylesheet, so no first paint waits on fonts.googleapis.com.
import '../styles/fonts.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { reelRouterScript } from '../lib/reelVisit';
import { isStorySampleBuild } from '../lib/storyChaptersSample';
import { langHeadScript } from '../i18n/runtime';
import { tr } from '../i18n/dict';
import T from '../i18n/T.astro';

// When this build was made, in the build machine's local time. Printed ONLY on
// the preview worker (the inline script before </body> checks the hostname),
// never on ryanxugallery.com: the owner has twice been looking at a stale tab
// or at production while believing it was the latest preview, and the two are
// identical above the fold. The stamp makes "which build is this?" a glance.
const buildStamp = new Date().toLocaleString('sv-SE', { hour12: false }).slice(0, 16);

interface Props {
  title?: string;
  description?: string;
  /** The title and description in Chinese: a Chinese reader's tab and
   *  bookmark (the page is one URL; src/i18n/runtime.ts swaps them before
   *  the first paint). Share cards and JSON-LD stay English — a crawler
   *  reads the page without its script. */
  titleZh?: string;
  descriptionZh?: string;
  ogImage?: string;
  ogType?: string;
  dark?: boolean;
  /** Page-specific JSON-LD blocks (e.g. ImageObject for a collection page).
   *  Concatenated with the default Person + WebSite blocks. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = tr('en', 'meta.defaultTitle'),
  description = tr('en', 'meta.defaultDescription'),
  titleZh = Astro.props.title ? undefined : tr('zh', 'meta.defaultTitle'),
  descriptionZh = Astro.props.description ? undefined : tr('zh', 'meta.defaultDescription'),
  ogImage = 'https://cdn.sanity.io/images/z610fooo/production/e69f9258142218c5cd649a9c01d4fe89d0335563-6048x4032.jpg?auto=format&w=1200&h=630&fit=crop&q=85',
  ogType = 'website',
  dark = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://ryanxugallery.com');
const siteUrl = (Astro.site ?? new URL('https://ryanxugallery.com')).toString().replace(/\/$/, '');

// ─── Default JSON-LD: Person (Ryan Xu) + WebSite ───
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ryan Xu',
  url: siteUrl,
  jobTitle: 'Photographer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New York',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.instagram.com/ryan_photoo/',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ryan Xu — Visual Archive',
  url: siteUrl,
  inLanguage: 'en-US',
};

const pageJsonLd = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];
const allJsonLd = [personSchema, websiteSchema, ...pageJsonLd];

// ─── Optional hub link (rel=me + footer link) ───
// Driven by PUBLIC_HUB_URL env var. Hidden when not set.
const hubUrl = import.meta.env.PUBLIC_HUB_URL || '';
const showGlobalSkipLink = Astro.url.pathname !== '/';
const travelWorkspaceActive = Astro.url.pathname.replace(/\/+$/, '') === '/travel';
// A build that prints a preview-only sample (npm run build:sample) says so
// on every page's <html>; wrangler refuses to deploy such a dist/ to
// production (scripts/assert-no-sample.mjs, wrangler.jsonc).
const storySample = isStorySampleBuild() || undefined;
const notesSample = process.env.NOTES_SAMPLE === '1' || undefined;
---

<html lang="en" class:list={[travelWorkspaceActive && 'travel-workspace-active']} data-story-sample={storySample} data-notes-sample={notesSample}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    {/* The webfonts' files (Fraunces, Space Grotesk) come from here; their
        rules are in the page's own stylesheet (src/styles/fonts.css). There
        is no render-blocking request to fonts.googleapis.com any more: it
        was a connection to a third host before every first paint. */}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Sanity CDN — every image on the site comes through here, so warm the TLS */}
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {/* mapbox preconnect only on /travel */}
    {/* Mapbox CSS is bundled with the Travel island; only its API hosts are preconnected there. */}

    <!-- Primary Meta -->
    <title data-zh={titleZh && titleZh !== title ? titleZh : undefined}>{title}</title>
    <meta name="description" content={description} data-zh={descriptionZh && descriptionZh !== description ? descriptionZh : undefined} />
    {/* 中 / EN before the first paint: the stored language on <html>
        (lang, data-lang), the title and description in it
        (src/i18n/runtime.ts). After the two it swaps and before the body
        is parsed: nothing paints in the wrong language. */}
    <script is:inline set:html={langHeadScript()} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content={dark ? '#282c20' : '#ffffff'} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ryan Xu | Visual Archive" />
    <meta property="og:locale" content="en_US" />
    {/* The same page reads in Chinese (中 / EN, one URL). */}
    <meta property="og:locale:alternate" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* ── rel=me linking to the personal info hub (IndieAuth / Mastodon-style) ── */}
    {hubUrl && <link rel="me" href={hubUrl} />}

    {/* ── Structured data: Person + WebSite + page-specific blocks ── */}
    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Page-specific <head> injections (preconnects, stylesheets) */}
    <slot name="head" />

    <!-- Astro View Transitions — smooth page navigation -->
    <ClientRouter />
  </head>

  <body class:list={[
    "min-h-screen font-sans antialiased overflow-x-hidden",
    dark ? "bg-[#282c20] text-[#F4F4ED]" : "bg-white text-gray-900",
    travelWorkspaceActive && "travel-workspace-active"
  ]}>
    {showGlobalSkipLink && (
      <a
        href="#main-content"
        class="fixed left-4 top-4 z-[100] inline-flex min-h-11 -translate-y-[160%] items-center rounded-full bg-[#F4F4ED] px-5 font-ui text-[10px] font-bold uppercase tracking-[0.1em] text-[#171b15] transition-transform duration-200 focus:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#D2FF00]"
      >
        <T k="a11y.skipToContent" />
      </a>
    )}
    <slot />

    {/* Global craft layers — a soft olive vignette for depth (behind content) and
        a fine STATIC film grain over everything (fixed, pointer-events-none, no
        animation → no flicker). The whole archive reads like film prints. */}
    <div class="page-vignette" aria-hidden="true"></div>
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Global image protection: prevent right-click, drag, long-press save, and print -->
    <style is:global>
      img {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
        pointer-events: auto;
        -webkit-user-drag: none;
        -khtml-user-drag: none;
        -moz-user-drag: none;
        -o-user-drag: none;
      }

      /* No rubber-band bounce and no overscroll gesture on the page, in either
         axis: fixed layers (the atlas, the grain, the nav) don't drift on iOS,
         and a sideways swipe on a Mac trackpad doesn't bounce the page or slide
         it toward the previous page — the page holds still under the hand.
         (The trade: the two-finger back-swipe doesn't navigate on this site;
         the browser's back button and keys still do.) */
      html, body {
        overscroll-behavior: none;
      }
      /* Touch devices don't get hover, so they shouldn't pay for cursor:none */
      @media (hover: none) {
        body { touch-action: manipulation; }
      }

      /* When printing, hide all images so a Save → Print → PDF route doesn't
         yield clean copies. Show a watermark in their place. */
      @media print {
        img, video, canvas, svg { display: none !important; }
        body::before {
          content: "© Ryan Xu · ryanxugallery.com — viewing copy, not for distribution.";
          display: block;
          padding: 2rem;
          font-family: ui-monospace, monospace;
          font-size: 12px;
          color: #444;
        }
        html[data-lang='zh'] body::before {
          content: "© Ryan Xu · ryanxugallery.com — 仅供浏览，请勿传播。";
        }
      }

      /* ═══════════════════════════════════════════════════════
       *  Directional Page Transition — "Card Stack" model
       *  — Forward (click into a section): the destination's own cover is
       *    the handoff (TravelEntryCover / AboutPage / Story cover); the
       *    root swap itself is instant.
       *  — Back (browser Back / back-direction link): OLD page falls 12vh
       *    and fades over the destination, which is already in place beneath
       *    it (the top card drops off the stack). Button-Back and link-Back
       *    share the same numbers, so they read as one gesture.
       *  — Map ↔ About: shared-axis push between two peer sections.
       *  Compositor-only transforms; no blur/box-shadow → smooth even
       *  while leaving heavy pages (e.g. /travel with Mapbox).
       * ═══════════════════════════════════════════════════════ */

      /* ─────────────────────────────────────────────────
       *  Default root swap — no animation. Directional motion is opted into
       *  per-navigation via html[data-axis] (below): "forward"/"back" for
       *  lateral siblings and "fall" for every back-direction change, browser
       *  Back or link. Everything else (going deeper) swaps instantly.
       *  ───────────────────────────────────────────────── */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }

      /* ───────────────────────────────────────────────
       *  Lateral sibling nav (Map ↔ About) — shared-axis push.
       *
       *  Apple / Material-grade peer-tab transition: the incoming page
       *  slides in OPAQUE over the outgoing one, which parallax-drifts the
       *  other way and dims. No full-screen masthead — switching between
       *  two peer sections should feel like a continuous spatial move, not
       *  an interruption. Direction (`forward` / `back`) is set on <html>
       *  by JS from the route order, and re-asserted in astro:after-swap
       *  (Astro wipes root attributes during the DOM swap).
       *  ─────────────────────────────────────────────── */
      html[data-axis]::view-transition-old(root) { z-index: 1; }
      html[data-axis]::view-transition-new(root) { z-index: 2; }

      /* The house arrive curve (it absorbed the push's own near-identical
         (0.22, 1, 0.36, 1)). The pseudo-elements inherit the tokens from
         <html>, where the Motion block defines them. */
      html[data-axis="forward"]::view-transition-old(root) {
        animation: sa-old-fwd 0.48s var(--ease-arrive) both;
      }
      html[data-axis="forward"]::view-transition-new(root) {
        animation: sa-new-fwd 0.48s var(--ease-arrive) both;
      }
      html[data-axis="back"]::view-transition-old(root) {
        animation: sa-old-back 0.48s var(--ease-arrive) both;
      }
      html[data-axis="back"]::view-transition-new(root) {
        animation: sa-new-back 0.48s var(--ease-arrive) both;
      }
      /* Quiet shared-axis movement. Keep it compositor-only: the earlier
         20px blur + 60% travel looked flashy and made Mapbox exits expensive. */
      @keyframes sa-old-fwd  {
        0%   { transform: translateX(0); opacity: 1; }
        100% { transform: translateX(-14%); opacity: 0.28; }
      }
      @keyframes sa-new-fwd  {
        0%   { transform: translateX(14%); opacity: 0.28; }
        100% { transform: translateX(0); opacity: 1; }
      }
      @keyframes sa-old-back {
        0%   { transform: translateX(0); opacity: 1; }
        100% { transform: translateX(14%); opacity: 0.28; }
      }
      @keyframes sa-new-back {
        0%   { transform: translateX(-14%); opacity: 0.28; }
        100% { transform: translateX(0); opacity: 1; }
      }

      /* ───────────────────────────────────────────────
       *  Back — the top card falls.
       *
       *  Only the OLD page moves: it drops 12vh and goes, revealing the
       *  destination already sitting still underneath. Browser Back and a
       *  back-direction link (the Home pill, a page's own Back) both come
       *  here, so they are one gesture. The z-index override is required:
       *  the generic rule above stacks old UNDER new, and a falling card has
       *  to be on top. `animation: none` on the new snapshot also means
       *  /travel's live Mapbox canvas is never transformed on the way home.
       *
       *  A fall eases IN (the site rule). On the house expo the card was at
       *  29% ink by 100ms and nobody saw it drop; it read as a cut. Now it
       *  holds at full ink for the first quarter, accelerates down 12vh, and
       *  fades on the ink companion of the leave curve — (0.55, 0, 1, 0.45)
       *  on opacity has a near-vertical end and popped 0.33 → 0 in its last
       *  two frames.
       *
       *  The fade's curve is written out: it is --ease-fade, but a var()
       *  inside a @keyframes rule is not resolved here (measured: the fade
       *  ran linear after the hold), while the shorthand's var(--ease-leave)
       *  is. Keep the two in step with the Motion block in global.css.
       *  ─────────────────────────────────────────────── */
      html[data-axis="fall"]::view-transition-old(root) {
        animation: fall-move 0.5s var(--ease-leave) both, fall-fade 0.5s linear both;
        z-index: 2;
      }
      html[data-axis="fall"]::view-transition-new(root) {
        animation: none;
        z-index: 1;
      }
      @keyframes fall-move {
        0%   { transform: translateY(0); }
        100% { transform: translateY(12vh); }
      }
      @keyframes fall-fade {
        0%   { opacity: 1; }
        25%  { opacity: 1; animation-timing-function: cubic-bezier(0.42, 0, 1, 1); /* --ease-fade */ }
        100% { opacity: 0; }
      }

      /* A repeat arrival by view transition has no entry cover (see the
         after-swap guard below); hide the server-painted plane until its
         island has hydrated and removed it. */
      html[data-entry-skip] [data-entry-cover] {
        visibility: hidden;
      }

      /* Reduced-motion: disable the directional view transitions. */
      @media (prefers-reduced-motion: reduce) {
        html[data-axis]::view-transition-old(root),
        html[data-axis]::view-transition-new(root) {
          animation: none !important;
        }
      }

      /* Reduce motion: instant transition for accessibility */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>

    {/* Custom cursor removed — the native cursor is the cursor. Interactive
        elements use standard `cursor: pointer` affordance. */}

    {/* The opening film on a second view (src/lib/reelVisit.ts): an in-site
        arrival at the homepage decides, on the incoming document, whether the
        film plays. Registered once per full load, on every page. */}
    <script is:inline set:html={reelRouterScript()} />
    <script is:inline>
      // ── Image protection ──
      // Block right-click anywhere on a photo (img tag OR a container that
      // declares itself as wrapping a protected image via .work-photo-item /
      // [data-protected] / nodes inside the lightbox).
      function isProtectedTarget(t) {
        if (!t || !t.closest) return false;
        if (t.tagName === 'IMG') return true;
        return !!t.closest('img, .work-photo-item, [data-protected], #lightbox, .photo-cell');
      }
      document.addEventListener('contextmenu', function(e) {
        if (isProtectedTarget(e.target)) e.preventDefault();
      }, true);
      document.addEventListener('dragstart', function(e) {
        if (isProtectedTarget(e.target)) e.preventDefault();
      }, true);
      // Block Cmd/Ctrl + S (save page) and Cmd/Ctrl + P (print).
      // Power users can still bypass via DevTools — this is a deterrent
      // for casual saving, not a security boundary.
      document.addEventListener('keydown', function(e) {
        var mod = e.metaKey || e.ctrlKey;
        if (mod && (e.key === 's' || e.key === 'S' || e.key === 'p' || e.key === 'P')) {
          e.preventDefault();
        }
      }, true);

      // ── Every in-site arrival asks for the page itself ──
      // Each page is a folder in the static build (/about/index.html), and
      // the host answers /about with a 307 to /about/: one more round trip on
      // a phone's network before every ClientRouter arrival (the nav, a
      // story's link, a note). The router fetches the folder straight away;
      // where it lands is the URL the redirect would have given. First of
      // the preparation listeners, so the ones below read the same address.
      document.addEventListener('astro:before-preparation', function(e) {
        var to = e && e.to;
        if (!to || to.origin !== window.location.origin) return;
        var path = to.pathname;
        if (path === '/' || path.charAt(path.length - 1) === '/' || /\.[a-z0-9]+$/i.test(path)) return;
        var folder = new URL(to.href);
        folder.pathname = path + '/';
        e.to = folder;
      });
      // A stylesheet that waits as print media on a full load, so it never
      // holds the first paint (the Chinese serif, CjkSerifLink.astro), is
      // already loaded by the router before an in-site swap: on the incoming
      // page it applies at once, as a plain stylesheet did.
      document.addEventListener('astro:before-swap', function(e) {
        var links = e && e.newDocument ? e.newDocument.querySelectorAll('link[rel="stylesheet"][data-swap-media]') : [];
        for (var i = 0; i < links.length; i += 1) links[i].setAttribute('media', 'all');
      });

      // ── Filmstrip scroll restoration ──
      // Save scroll position when leaving Homepage. A direct Home link restores
      // it before the incoming transition snapshot; browser history traversal
      // keeps Astro's own stored scroll state instead of being overwritten.
      var restoreHomeScrollOnSwap = false;
      function readHomeFilmstripScroll() {
        var body = document.body;
        // An open Homepage Story fixes body at the negative archive offset;
        // window.scrollY is then zero. Reuse that actual lock position rather
        // than saving a new top-of-page position over the visitor's chapter.
        if (body.style.position === 'fixed') {
          var fixedTop = parseFloat(body.style.top || getComputedStyle(body).top);
          if (Number.isFinite(fixedTop)) return Math.max(0, -fixedTop);
        }
        return window.scrollY;
      }
      function transitionPath(value, fallback) {
        if (!value) return fallback;
        try { return new URL(value, window.location.origin).pathname; }
        catch (err) { return fallback; }
      }
      document.addEventListener('astro:before-preparation', function(e) {
        var fromPath = transitionPath(e && e.from, window.location.pathname);
        var toPath = transitionPath(e && e.to, window.location.pathname);
        if (fromPath === '/' && toPath !== '/') {
          sessionStorage.setItem('home-filmstrip-scroll', String(readHomeFilmstripScroll()));
        }
        restoreHomeScrollOnSwap = toPath === '/' && (!e || e.navigationType !== 'traverse');
      });
      document.addEventListener('astro:before-swap', function(e) {
        var fromPath = transitionPath(e && e.from, window.location.pathname);
        var toPath = transitionPath(e && e.to, window.location.pathname);
        if (fromPath !== '/' || toPath === '/' || e.navigationType === 'traverse' || !history.state) return;
        // Astro has finished sampling scroll by this point but has not pushed
        // the destination entry yet. Correct the existing Home entry so native
        // Back restores it too; never overwrite the destination of a traversal.
        history.replaceState(Object.assign({}, history.state, { scrollY: readHomeFilmstripScroll() }), '');
      });
      function restoreHomeFilmstrip() {
        if (restoreHomeScrollOnSwap && window.location.pathname === '/') {
          restoreHomeScrollOnSwap = false;
          var saved = sessionStorage.getItem('home-filmstrip-scroll');
          if (saved) {
            sessionStorage.removeItem('home-filmstrip-scroll');
            var y = parseInt(saved, 10);
            // Only restore if user was past the hero (i.e., in the filmstrip
            // area).
            if (y > 100) {
              // after-swap runs before the browser captures the incoming View
              // Transition snapshot. Restore now so Home never appears at the
              // top and then jumps to the visitor's previous chapter.
              window.scrollTo({ top: y, behavior: 'instant' });
            }
          }
        }
      }
      document.addEventListener('astro:after-swap', restoreHomeFilmstrip);

      // ── Page-transition direction (View Transitions) ──
      // Sets html[data-axis] from the route relationship so the global
      // ::view-transition(root) rules animate the right way:
      //   Home → Map      : Atlas editorial cover (TravelEntryCover)
      //   Home → About    : contributor cover (AboutPage)
      //   Map ↔ About      : shared-axis push ("forward" / "back")
      //   back direction  : the top card falls ("fall") — browser Back, the
      //                     Home pill, a story's Back, /works → Map
      // (Opening a story is the React MagazineLayout cover.)
      (function() {
        function normalize(path) {
          if (!path) return '/';
          if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
          return path;
        }
        function depth(path) { return path.split('/').filter(Boolean).length; }

        // Route order for lateral sibling nav (Map · Notes · About).
        var LATERAL = { '/travel': 1, '/notes': 1.5, '/about': 2 };
        var pendingAxis = null; // 'forward' | 'back' | 'fall'

        document.addEventListener('astro:before-preparation', function(e) {
          if (!(e && e.to)) return;
          var toPath = '';
          try { toPath = new URL(e.to, window.location.origin).pathname; }
          catch (err) { return; }
          var fromPath = window.location.pathname;
          try {
            if (e.from) fromPath = new URL(e.from, window.location.origin).pathname;
          } catch (err) {}
          var nf = normalize(fromPath);
          var nt = normalize(toPath);
          document.documentElement.removeAttribute('data-axis');
          pendingAxis = null;
          if (nt === nf) return;

          // Lateral sibling nav (Map ↔ About): shared-axis push.
          if (LATERAL[nf] && LATERAL[nt]) {
            pendingAxis = LATERAL[nt] > LATERAL[nf] ? 'forward' : 'back';
            document.documentElement.setAttribute('data-axis', pendingAxis);
            return;
          }

          // Back falls, whether it came from history or from a link. A link is
          // back-direction when it goes Home or to a shallower page — checked
          // on the paths, before Astro changes the current URL. It used to be
          // a separate body exit that faded the page to an empty olive screen
          // for ~300ms and only then asked for the destination; now it is the
          // same view transition as browser Back, with the destination (the
          // Home the visitor left, restored to their chapter in after-swap)
          // already in place beneath the falling card.
          var backLink = e.navigationType !== 'traverse' && (nt === '/' || depth(nt) < depth(nf));
          if ((e.navigationType === 'traverse' && e.direction === 'back') || backLink) {
            // The destination sits still at z-index 1 with no animation; if
            // it paints late, the falling card exposes the html canvas. A
            // Story leaves that canvas at its lighter #30352a (WorkStory.tsx),
            // which would read as a colour band under the fall. Set it to the
            // page field before the transition starts (every page is dark).
            // Astro's swap replaces <html>'s attributes with the new page's,
            // which drops this inline style again.
            document.documentElement.style.backgroundColor = '#282c20';
            pendingAxis = 'fall';
            document.documentElement.setAttribute('data-axis', pendingAxis);
            return;
          }

          // When entering either primary destination from elsewhere, its own
          // editorial cover remains the single handoff. This check must follow
          // the sibling case above or Map ↔ About can never receive an axis.
          if (nt === '/about' || nt === '/travel') return;

        });

        // A repeat arrival by view transition gets no entry cover: the
        // destination's island decides that at mount (TravelEntryCover,
        // AboutPage: seen this session — or deep-linked, where the page
        // counts that — with html[data-axis] set). The plane is server-
        // painted, though, and on a slow line the island hydrated a few
        // frames into the push, so the plane rode in and then cut (measured
        // at 4× CPU: 5–14 frames). The same rule, applied here before the new
        // snapshot is taken, hides it from the first frame. The attribute
        // leaves with the next swap, as data-axis does.
        function hideSkippedEntryCover() {
          var cover = document.querySelector('[data-entry-cover]');
          if (!cover) return;
          var seen = false;
          try { seen = sessionStorage.getItem(cover.getAttribute('data-entry-cover')) === 'true'; }
          catch (err) {}
          var deepLinked = cover.hasAttribute('data-entry-deeplink')
            && (window.location.search.length > 1 || window.location.hash.length > 1);
          if (seen || deepLinked) document.documentElement.setAttribute('data-entry-skip', '');
        }

        // Astro wipes <html> attributes during the DOM swap, so the axis set
        // in before-preparation is gone by the time the browser computes the
        // ::view-transition animation. astro:after-swap runs synchronously
        // inside the view-transition update callback (after the attribute
        // wipe, before the new snapshot is styled) — re-assert it here.
        document.addEventListener('astro:after-swap', function() {
          if (pendingAxis) {
            document.documentElement.setAttribute('data-axis', pendingAxis);
            hideSkippedEntryCover();
          }
        });
      })();
    </script>
    <script is:inline define:vars={{ buildStamp }}>
      (function () {
        if (location.hostname.indexOf('preview.') !== 0) return;
        if (document.getElementById('preview-build-stamp')) return;
        var stamp = document.createElement('div');
        stamp.id = 'preview-build-stamp';
        stamp.className = 'font-ui';
        stamp.setAttribute('aria-hidden', 'true');
        stamp.textContent = (document.documentElement.getAttribute('data-lang') === 'zh' ? '预览 · 构建 ' : 'Preview · build ') + buildStamp;
        // Legible on purpose. The first 9px / 62% version was not seen: the
        // audit found every "old version" report was a view of the NEW build
        // judged from a first screen that is identical to production.
        // A bone rim, not lime: lime is the page's one interface mark, and the
        // stamp is on every view the owner reviews.
        // Its own view-transition name: as a child of <html> it was inside
        // both root snapshots, so it doubled and slid with every push and
        // dropped with every fall. Named, it is one identical old/new pair
        // and holds still while the pages move around it.
        stamp.style.cssText = 'position:fixed;left:12px;bottom:12px;z-index:130;padding:8px 12px;border-radius:999px;border:1px solid rgba(244,244,237,.4);background:rgba(11,14,9,.9);color:#F4F4ED;font-size:11px;line-height:1;letter-spacing:.1em;text-transform:uppercase;pointer-events:none;view-transition-name:preview-stamp';
        // On <html>, not <body>: ClientRouter swaps the body's children on
        // every in-site navigation and would take the stamp with them.
        document.documentElement.appendChild(stamp);
      })();
    </script>
  </body>
</html>
