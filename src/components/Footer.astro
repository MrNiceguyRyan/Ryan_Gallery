---
// Shared site footer — a landonorris-style closing statement used across the
// whole (dark) site: a big two-tone headline with a script signature, a Pages
// column, social links with a clip-masked vertical "roll" hover, an enquiries
// pill, and a quiet meta bar. The single accent is the site-wide electric lime
// (rgb(var(--accent-r/g/b)) — set on the homepage wrapper, and inherited from
// the @property default everywhere else).
interface Props {
  dark?: boolean;
}
// Kept for call-site compatibility; the redesigned site is dark throughout.
const { dark = true } = Astro.props;
const year = new Date().getFullYear();

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Travel', href: '/travel' },
  { label: 'About', href: '/about' },
];

// Real handles (carried over from the old inline homepage footer). No
// `siteSettings` document exists in Sanity yet; if more platforms are wanted,
// add them here (or create the siteSettings doc and wire this to it).
const social = [
  { label: 'Instagram', href: 'https://www.instagram.com/ryan_photoo/' },
  { label: 'Email', href: 'mailto:ryan2420159421@gmail.com' },
];
const contactHref = 'mailto:ryan2420159421@gmail.com';
---
<footer class="site-footer relative overflow-hidden bg-[#181b10] text-[#E6E9E7] border-t border-white/10">
  {/* Atmosphere — faint topographic contour + a soft cool edge-glow */}
  <div class="footer-atmos" aria-hidden="true">
    <svg viewBox="0 0 1440 520" preserveAspectRatio="none">
      <path d="M-40 120 Q360 40 720 130 T1480 120" />
      <path d="M-40 190 Q380 110 740 200 T1480 188" />
      <path d="M-40 262 Q360 188 720 270 T1480 258" />
      <path d="M-40 336 Q400 262 760 344 T1480 330" />
      <path d="M-40 410 Q360 340 720 416 T1480 404" />
      <path d="M-40 482 Q380 414 740 488 T1480 476" />
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-28">
    {/* Headline + signature */}
    <div class="footer-statement relative">
      <span class="footer-sig font-signature" aria-hidden="true">Ryan</span>
      <h2 class="footer-headline font-serif">
        Always chasing<br /><span class="accent">the light.</span>
      </h2>
    </div>

    {/* Links row */}
    <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-[1fr_1fr_auto] gap-x-8 gap-y-12 md:gap-12 items-start">
      <nav aria-label="Pages">
        <p class="footer-label">Pages</p>
        <ul class="mt-5 space-y-3">
          {pages.map((p) => (
            <li><a class="navlink" href={p.href} data-cursor={p.label}>{p.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="footer-label">Follow</p>
        <ul class="mt-5 space-y-3">
          {social.map((s) => (
            <li>
              <a class="sociallink" href={s.href} rel="me noopener" target="_blank">
                <span class="flip">
                  <span class="flip-inner">
                    <span class="flip-line">{s.label}</span>
                    <span class="flip-line" aria-hidden="true">{s.label}</span>
                  </span>
                </span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a class="enquiry-pill col-span-2 md:col-span-1 justify-self-start md:justify-self-end" href={contactHref} data-cursor="Say hello">
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </div>

    {/* Meta bar */}
    <div class="footer-meta mt-16 md:mt-24 pt-6 border-t border-white/10 flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
      <span>© {year} Ryan Xu. All rights reserved.</span>
      <span class="footer-cameras">Fujifilm X-T50 · Nikon Zf</span>
      <a href="/">ryanxugallery.com</a>
    </div>
  </div>
</footer>

<style>
  .footer-atmos { position: absolute; inset: 0; pointer-events: none; }
  .footer-atmos svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .footer-atmos path {
    fill: none;
    stroke: rgb(var(--accent-r), var(--accent-g), var(--accent-b));
    stroke-width: 1;
    opacity: 0.06;
  }
  .footer-atmos::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(58% 78% at 50% 116%, rgba(var(--accent-r), var(--accent-g), var(--accent-b), 0.08), transparent 70%);
  }

  .footer-headline {
    font-size: clamp(42px, 8vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: 400;
    color: #E6E9E7;
  }
  .footer-headline .accent { color: rgb(var(--accent-r), var(--accent-g), var(--accent-b)); }

  .footer-sig {
    position: absolute;
    top: -0.42em;
    right: 6%;
    z-index: 2;
    font-size: clamp(36px, 7vw, 88px);
    line-height: 1;
    color: rgb(var(--accent-r), var(--accent-g), var(--accent-b));
    transform: rotate(-8deg);
    opacity: 0.92;
    pointer-events: none;
  }

  .footer-label {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 10px;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgba(230, 233, 231, 0.34);
  }

  .navlink {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(230, 233, 231, 0.7);
    transition: color 0.4s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navlink:hover {
    color: rgb(var(--accent-r), var(--accent-g), var(--accent-b));
    transform: translateX(5px);
  }

  /* Social links — clip-masked vertical roll: the label rolls up and is
     replaced by its duplicate, turns accent, and an arrow slides in. */
  .sociallink {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(230, 233, 231, 0.62);
    transition: color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .flip { display: inline-block; overflow: hidden; line-height: 1.2; vertical-align: bottom; }
  .flip-inner {
    display: flex;
    flex-direction: column;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .flip-line { display: block; }
  .arrow {
    transform: translate(-5px, 0);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  .sociallink:hover { color: rgb(var(--accent-r), var(--accent-g), var(--accent-b)); }
  .sociallink:hover .flip-inner { transform: translateY(-50%); }
  .sociallink:hover .arrow { transform: translate(0, 0); opacity: 1; }

  .enquiry-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(230, 233, 231, 0.85);
    border: 1px solid rgba(230, 233, 231, 0.22);
    background: transparent;
    padding: 14px 22px;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }
  .enquiry-pill:hover {
    transform: translateY(-2px);
    color: #181b10;
    background: rgb(var(--accent-r), var(--accent-g), var(--accent-b));
    border-color: rgb(var(--accent-r), var(--accent-g), var(--accent-b));
  }

  .footer-meta {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(230, 233, 231, 0.3);
  }
  .footer-meta a { transition: color 0.4s ease; }
  .footer-meta a:hover { color: rgba(230, 233, 231, 0.72); }

  @media (prefers-reduced-motion: reduce) {
    .flip-inner, .arrow, .navlink, .enquiry-pill { transition: color 0.3s ease, background 0.3s ease, border-color 0.3s ease; }
    .sociallink:hover .flip-inner { transform: none; }
    .sociallink:hover .arrow { opacity: 1; transform: none; }
    .navlink:hover { transform: none; }
    .enquiry-pill:hover { transform: none; }
  }
</style>
