---
// One photograph in a note, at its own ratio (the kept part of the file; a
// note never crops a picture to fit a box), numbered like the Story's frames,
// with his caption in sentence case. 中 / EN: a caption with a Chinese twin
// prints both (the page shows the reader's); the alt is the reader's, from
// the pair the head script applies (i18nAttrs).
import Bi from '../../i18n/Bi.astro';
import { i18nAttrs, tr } from '../../i18n/dict';
import { blockLang, imageSrcSet, imageUrl, orientation, pad2, twinOf, type NoteImage } from '../../lib/notes';

interface Props {
  image: NoteImage;
  width: number;
  height: number;
  /** The figure's number in the note ("01"); none for the cover. */
  number?: number;
  /** 'float' hangs a portrait beside the opening of the text (desktop). */
  placement?: 'flow' | 'cover' | 'float';
  eager?: boolean;
}

const { image, width, height, number, placement = 'flow', eager = false } = Astro.props;
const shape = orientation(width, height);
const caption = image.caption?.trim() || '';
const captionZh = twinOf(caption, image.captionZh);
// A caption he wrote only in Chinese (no English beside it) shows in
// Chinese only.
const captionZhOnly = !caption ? image.captionZh?.trim() || '' : '';
const nn = number ? pad2(number) : '';
const own = image.alt?.trim() || caption;
const alt = own || (number ? tr('en', 'note.photo', { nn }) : tr('en', 'note.photoPlain'));
const altZh =
  twinOf(image.alt?.trim() || caption, image.altZh) ||
  captionZh ||
  (own ? alt : image.altZh?.trim() || captionZhOnly || (number ? tr('zh', 'note.photo', { nn }) : tr('zh', 'note.photoPlain')));
const altAttrs = altZh && altZh !== alt ? i18nAttrs({ alt: { en: alt, zh: altZh } }) : { alt };
const sizes =
  shape === 'landscape'
    ? '(min-width: 1024px) 72vw, 100vw'
    : '(min-width: 1024px) 34vw, 86vw';
---

<figure
  class:list={['note-figure', `note-figure--${shape}`, `note-figure--${placement}`]}
  style={`--r: ${(width / height).toFixed(5)}`}
>
  <img
    src={imageUrl(image, shape === 'landscape' ? 1600 : 1000)}
    srcset={imageSrcSet(image)}
    sizes={sizes}
    width={width}
    height={height}
    {...altAttrs}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    draggable="false"
  />
  {(number || caption || captionZhOnly) && (
    <figcaption class="note-cap font-ui">
      {number ? <b>{nn}</b> : null}
      {caption && <span lang={blockLang(caption, captionZh)}><Bi en={caption} zh={captionZh} /></span>}
      {captionZhOnly && <span data-l="zh" lang="zh-Hans">{captionZhOnly}</span>}
    </figcaption>
  )}
</figure>
