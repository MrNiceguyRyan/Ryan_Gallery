---
// The arrow the Story draws (MagazineLayout's Arrow): Space Grotesk has no →,
// and a typed one falls through to another face, so it is drawn, in the ink
// of the words it follows (currentColor).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 16 10" width="16" height="10" aria-hidden="true" focusable="false">
  <path d="M1 5h13.5M10.5 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
</svg>
